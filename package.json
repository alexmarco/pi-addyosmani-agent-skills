{
  "name": "pi-addyosmani-agent-skills",
  "version": "0.1.0",
  "private": true,
  "description": "Pi adapter for Addy Osmani's upstream agent skills",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "extensions/",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "pi-package",
    "pi",
    "agent-skills"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexmarco/pi-addyosmani-agent-skills.git"
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@types/node": "22.19.19",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test --test-concurrency=1 tests/*.test.ts",
    "check": "npm run format:check && npm run typecheck && npm test"
  }
}
